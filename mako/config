# Kanagawa Wave — same palette as nvim, foot, tmux, sway, waybar, pi and VS Code.
# sumiInk0 #16161d  sumiInk3 #1f1f28  sumiInk5 #363646
# fujiWhite #dcd7ba  fujiGray #727169  crystalBlue #7e9cd8
# carpYellow #e6c384  roninYellow #ff9e3b  samuraiRed #e82424

font=JetBrainsMono Nerd Font 10

background-color=#1f1f28f2
text-color=#dcd7ba
border-color=#363646
progress-color=over #2d4f67

border-size=2
border-radius=6
padding=12,16
margin=8
width=420
height=160

# Top-right, clear of the waybar at the top of the screen.
anchor=top-right
layer=overlay
default-timeout=5000
ignore-timeout=0
max-visible=5

markup=1
format=<b>%s</b>\n%b
icons=1
max-icon-size=48

# Urgency levels are the whole point of a notification daemon — if they all look
# the same you have to read every one. Border carries the signal; the background
# stays constant so the popup is always legible.
[urgency=low]
text-color=#727169
border-color=#2a2a37
default-timeout=3000

[urgency=normal]
border-color=#7e9cd8

[urgency=critical]
border-color=#e82424
text-color=#dcd7ba
background-color=#43242bf2
default-timeout=0

# Focused/hovered notification gets the accent so you can see what you are about
# to dismiss.
[mode=do-not-disturb]
invisible=1

[app-name="Spotify"]
default-timeout=5000
border-color=#98bb6c
