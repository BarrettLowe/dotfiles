{
    "vscode-neovim.neovimExecutablePaths.linux": "/opt/nvim-linux-x86_64/bin/nvim",
    "vscode-neovim.neovimInitVimPaths.linux": "/home/barrett-lowe/dotfiles/.vimrc",
    "remote.extensionKind": {
        "asvetliakov.vscode-neovim": ["ui"]
    },
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "chat.viewSessions.orientation": "stacked",
    "github.copilot.chat.customOAIModels": {
            "lmstudio": {
                "name": "LM Studio",
                "requiresAPIKey": false,
                "url": "http://localhost:1234",
                "toolCalling": true,
                "vision": true,
                "maxInputTokens": 21504,
                "maxOutputTokens": 21504,
            }
        },
        "workbench.colorTheme": "Kanagawa Wave",
        // Without this the window title bar is drawn by GTK, which paints it
        // light regardless of the theme. "custom" lets VS Code colour it.
        "window.titleBarStyle": "custom",
        "C_Cpp.intelliSenseEngine": "disabled",
        "git.confirmSync": false,
        "git.autofetch": true,
        "gitlab.duoCodeSuggestions.enabled": false,
        "gitlab.duoChat.enabled": false,
        "gitlab.duoAgentPlatform.enabled": false,
        "gitlab.duo.enabledWithoutGitlabProject": false,
        "gitlab.duoCodeSuggestions.openTabsContext": false,
        "gitlens.graph.details.location": "auto",
        "gitlens.plusFeatures.enabled": false,
        "python.analysis.typeCheckingMode": "standard",
}