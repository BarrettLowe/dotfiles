{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kanagawa Wave",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#a3d4d5",
    "class": "#7aa89f",
    "struct": "#7aa89f",
    "enum": "#7aa89f",
    "interface": {
      "foreground": "#7aa89f",
      "fontStyle": "italic"
    },
    "typeParameter": {
      "foreground": "#938aa9",
      "fontStyle": "italic"
    },
    "type": "#7aa89f",
    "parameter": {
      "foreground": "#c8c093",
      "fontStyle": "italic"
    },
    "variable": "#dcd7ba",
    "variable.readonly": "#ffa066",
    "variable.defaultLibrary": "#e46876",
    "property": "#e6c384",
    "property.readonly": "#ffa066",
    "enumMember": "#ffa066",
    "event": "#d27e99",
    "function": "#7e9cd8",
    "function.defaultLibrary": "#7fb4ca",
    "method": "#7e9cd8",
    "macro": "#ffa066",
    "label": "#d27e99",
    "keyword": "#957fb8",
    "modifier": "#ff5d62",
    "comment": {
      "foreground": "#727169",
      "fontStyle": "italic"
    },
    "string": "#98bb6c",
    "number": "#d27e99",
    "regexp": "#c0a36e",
    "operator": "#c0a36e",
    "decorator": "#ffa066",
    "selfKeyword": {
      "foreground": "#e46876",
      "fontStyle": "italic"
    },
    "builtinType": "#7aa89f",
    "*.deprecated": {
      "fontStyle": "strikethrough"
    }
  },
  "colors": {
    "focusBorder": "#54546d",
    "foreground": "#dcd7ba",
    "disabledForeground": "#727169",
    "descriptionForeground": "#727169",
    "errorForeground": "#e82424",
    "widget.shadow": "#16161d80",
