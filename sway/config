include /etc/sway/config.d/*

gaps inner 6
# gaps outer 2
default_orientation horizontal

# Remap capslock to ctrl for all keyboards
input "type:keyboard" {
    xkb_layout "us,graphite"
    xkb_options ctrl:nocaps
}

# Toggle between US and Graphite layouts
bindsym Alt+Shift+space input type:keyboard xkb_switch_layout next

default_border pixel 2
default_floating_border pixel 2

# Hide the border when a workspace holds a single window; the focus indicator is
# only useful when there is another window it could be pointing away from.
smart_borders on

# Kanagawa Wave palette — same source as the nvim colorscheme, foot, waybar and tmux.
# sumiInk0 #16161d  sumiInk3 #1f1f28  sumiInk4 #2a2a37  sumiInk5 #363646
# fujiWhite #dcd7ba  fujiGray #727169  crystalBlue #7e9cd8  autumnRed #c34043
#
# Structure: client.<class> <border> <bg> <text> <indicator> <child_border>
# "indicator" marks the edge a new split would open on, so it is deliberately a
# different hue from the border — otherwise you cannot see which way a split goes.
client.focused          #7e9cd8 #2a2a37 #dcd7ba #e6c384 #7e9cd8
client.focused_inactive #363646 #1f1f28 #c8c093 #363646 #363646
client.unfocused        #2a2a37 #16161d #727169 #2a2a37 #2a2a37
client.urgent           #c34043 #1f1f28 #dcd7ba #c34043 #c34043

# focus_on_window_activation focus
# for_window [app_id="microsoft-edge"] focus
for_window [urgent=latest] focus

# Target the "anonymous" Teams notification window
for_window [shell="xdg_shell" app_id="^$" title="^$"] floating enable, move position 2800 50, sticky enable, no_focus

# Claude TUI scratchpad — float, size, and park in scratchpad on spawn
for_window [app_id="claude-tui"] {
    floating enable
    resize set 420 900
}

exec_always killall waybar; sleep 0.5 && waybar
exec mako
exec blueman-applet
